<Page x:Class="PIA_ParkUANL_Lite.RegistroCasetaPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PIA_ParkUANL_Lite"
      Background="{StaticResource Fondo}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:EncabezadoUanl Titulo="Caseta de acceso" Subtitulo="{x:Bind Vista.Subtitulo}" ComandoCuenta="{x:Bind Vista.CambiarContrasenaCommand}" />
        <ScrollViewer Grid.Row="1">
            <Grid Margin="16,12,16,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Estacionamiento y ocupación -->
                    <Border Style="{StaticResource Grupo}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Estacionamiento" Style="{StaticResource TituloGrupo}" />
                            <ComboBox x:Name="comboEstacionamiento" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vista.OpcionesDeEstacionamiento}"
                                      SelectedItem="{x:Bind Vista.OpcionEstacionamiento, Mode=TwoWay, Converter={StaticResource ATexto}}" />
                            <TextBlock Text="Ocupación FACPYA" Style="{StaticResource Etiqueta}" />
                            <local:BarraOcupacion x:Name="barraFacpya" Resumen="{x:Bind Vista.ResumenFacpya, Mode=OneWay}" />
                            <TextBlock x:Name="etiquetaDetalleFacpya" Style="{StaticResource Etiqueta}" Text="{x:Bind Vista.DetalleFacpya, Mode=OneWay}" />
                            <TextBlock Text="Ocupación Estadio" Style="{StaticResource Etiqueta}" />
                            <local:BarraOcupacion x:Name="barraEstadio" Resumen="{x:Bind Vista.ResumenEstadio, Mode=OneWay}" />
                            <TextBlock x:Name="etiquetaDetalleEstadio" Style="{StaticResource Etiqueta}" Text="{x:Bind Vista.DetalleEstadio, Mode=OneWay}" />
                            <TextBlock x:Name="etiquetaResumen" Style="{StaticResource Etiqueta}" Foreground="{StaticResource AzulUanl}" Text="{x:Bind Vista.ResumenSeleccionado, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Entrada manual -->
                    <Border Grid.Column="1" Style="{StaticResource Grupo}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Entrada manual" Style="{StaticResource TituloGrupo}" />
                            <Grid ColumnSpacing="8" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Categoría" Style="{StaticResource EtiquetaCentrada}" />
                                <ComboBox x:Name="comboCategoria" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vista.CategoriasDisponibles}"
                                          SelectedItem="{x:Bind Vista.Categoria, Mode=TwoWay, Converter={StaticResource ATexto}}" />
                                <TextBlock Grid.Row="1" Text="Nombre" Style="{StaticResource EtiquetaCentrada}" />
                                <TextBox x:Name="cajaNombre" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" MaxLength="{x:Bind local:Validaciones.LongitudMaximaNombre}"
                                         Text="{x:Bind Vista.Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Text="Matrícula" Style="{StaticResource EtiquetaCentrada}" />
                                <TextBox x:Name="cajaMatricula" Grid.Row="2" Grid.Column="1" MaxLength="{x:Bind local:Validaciones.LongitudMatricula}"
                                         Text="{x:Bind Vista.Matricula, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Name="botonBuscarMatricula" Grid.Row="2" Grid.Column="2" Content="Buscar" Style="{StaticResource BotonOro}" VerticalAlignment="Stretch"
                                        Command="{x:Bind Vista.AutocompletarCommand}" />
                                <TextBlock Grid.Row="3" Text="Correo" Style="{StaticResource EtiquetaCentrada}" />
                                <TextBox x:Name="cajaCorreo" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" MaxLength="{x:Bind local:Validaciones.LongitudMaximaCorreo}"
                                         Text="{x:Bind Vista.Correo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="4" Text="Placa" Style="{StaticResource EtiquetaCentrada}" />
                                <TextBox x:Name="cajaPlaca" Grid.Row="4" Grid.Column="1" CharacterCasing="Upper" MaxLength="{x:Bind local:Validaciones.LongitudMaximaPlaca}"
                                         Text="{x:Bind Vista.Placa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Name="botonBuscarPlaca" Grid.Row="4" Grid.Column="2" Content="Buscar" Style="{StaticResource BotonOro}" VerticalAlignment="Stretch"
                                        Command="{x:Bind Vista.AutocompletarCommand}" />
                                <TextBlock Grid.Row="5" Text="Evento" Style="{StaticResource EtiquetaCentrada}" />
                                <ComboBox x:Name="comboEvento" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vista.EventosVigentes, Mode=OneWay}"
                                          SelectedItem="{x:Bind Vista.EventoElegido, Mode=TwoWay, Converter={StaticResource ATexto}}" />
                            </Grid>

                            <!-- "Buscar" llena los demás campos con el registro de la Comunidad UANL o con la última visita -->
                            <TextBlock Text="Escribe matrícula o placa y presiona Buscar (o Enter)" Style="{StaticResource Etiqueta}" FontSize="11" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="94" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="botonEntrada" Content="Registrar entrada" Style="{StaticResource BotonVerde}" Command="{x:Bind Vista.RegistrarEntradaManualCommand}" />
                                <Button x:Name="botonLimpiar" Grid.Column="1" Content="Limpiar" Style="{StaticResource BotonGris}" Command="{x:Bind Vista.LimpiarEntradaManualCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Entrada con QR y salida -->
                    <StackPanel Grid.Column="2" Spacing="10">
                        <Border Style="{StaticResource Grupo}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Entrada con código QR" Style="{StaticResource TituloGrupo}" />
                                <TextBlock Text="Pega el texto del QR (token UANL o pase de visitante):" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="cajaCodigoQr" TextWrapping="Wrap" MinHeight="56" MaxLength="{x:Bind local:GeneradorQR.MaximoCaracteres}"
                                         Text="{x:Bind Vista.CodigoQr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Name="botonQr" Content="Validar QR y registrar entrada" Style="{StaticResource BotonAzul}" Command="{x:Bind Vista.ValidarQrCommand}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Grupo}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Salida" Style="{StaticResource TituloGrupo}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Placa o matrícula:" Style="{StaticResource EtiquetaCentrada}" />
                                    <TextBox x:Name="cajaBuscarSalida" Grid.Column="1" CharacterCasing="Upper" MaxLength="{x:Bind local:Validaciones.LongitudMaximaPlaca}"
                                             Text="{x:Bind Vista.BusquedaSalida, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button x:Name="botonBuscar" Grid.Column="2" Content="Buscar" Style="{StaticResource BotonOro}" VerticalAlignment="Stretch" Command="{x:Bind Vista.BuscarSalidaCommand}" />
                                </Grid>
                                <TextBlock x:Name="etiquetaInfoSalida" Style="{StaticResource Etiqueta}" MinHeight="36" Text="{x:Bind Vista.InformacionSalida, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="116" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="botonSalida" Content="Registrar salida" Style="{StaticResource BotonRojo}" Command="{x:Bind Vista.RegistrarSalidaCommand}" />
                                    <Button x:Name="botonCerrar" Grid.Column="1" Style="{StaticResource BotonGris}" Content="{x:Bind Vista.TextoBotonCerrar}" Command="{x:Bind Vista.CerrarCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="barraMensaje" Grid.Row="1" IsClosable="False"
                         IsOpen="{x:Bind Vista.HayMensaje, Mode=OneWay}" Message="{x:Bind Vista.Mensaje, Mode=OneWay}"
                         Severity="{x:Bind local:Conversiones.Severidad(Vista.TipoMensaje), Mode=OneWay}" />
                <TextBlock Grid.Row="2" Text="Últimos movimientos" Style="{StaticResource Etiqueta}" FontWeight="SemiBold" />
                <local:TablaDatos x:Name="tablaMovimientos" Grid.Row="3" Height="220" Columnas="Placa,Nombre,Categoría,Estacionamiento,Cajón,Método,Entrada,Salida,Estancia"
                                  Filas="{x:Bind Vista.Movimientos, Mode=OneWay}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
