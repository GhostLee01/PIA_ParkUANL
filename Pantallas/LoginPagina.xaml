<Page x:Class="PIA_ParkUANL.LoginPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PIA_ParkUANL"
      Background="{StaticResource Fondo}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:EncabezadoUanl Titulo="Inicio de sesión" Subtitulo="Caseta Operativa y Panel de Control" />
        <ScrollViewer Grid.Row="1">
            <!-- La ventana es grande: el formulario va en una tarjeta angosta y centrada -->
            <Border Style="{StaticResource Grupo}" MaxWidth="460" Margin="20,28,20,28" Padding="28,22" VerticalAlignment="Top">
                <StackPanel Spacing="6">
                    <Image x:Name="logoParkUanl" Source="ms-appx:///Assets/Logos/png/logo-horizontal.png" Width="300" HorizontalAlignment="Center"
                           Margin="0,0,0,12" AutomationProperties.Name="ParkUANL, control de acceso vehicular" />
                    <TextBlock Text="Usuario o correo universitario" Style="{StaticResource Etiqueta}" />
                    <TextBox x:Name="cajaUsuario" MaxLength="{x:Bind local:Validaciones.LongitudMaximaCorreo}"
                             Text="{x:Bind Vista.Usuario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Contraseña" Style="{StaticResource Etiqueta}" Margin="0,6,0,0" />
                    <PasswordBox x:Name="cajaContrasena" MaxLength="{x:Bind local:Validaciones.LongitudMaximaContrasenaGuardada}"
                                 Password="{x:Bind Vista.Contrasena, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordRevealMode="{x:Bind local:Conversiones.ModoDeContrasena(Vista.MostrarContrasena), Mode=OneWay}" />
                    <CheckBox x:Name="casillaMostrarContrasena" Content="Mostrar contraseña"
                              IsChecked="{x:Bind Vista.MostrarContrasena, Mode=TwoWay}" />
                    <Button x:Name="botonEntrar" Content="Iniciar sesión" Style="{StaticResource BotonAzul}"
                            Command="{x:Bind Vista.IniciarSesionCommand}" />
                    <InfoBar x:Name="barraMensaje" IsClosable="False"
                             IsOpen="{x:Bind Vista.HayMensaje, Mode=OneWay}" Message="{x:Bind Vista.Mensaje, Mode=OneWay}"
                             Severity="{x:Bind local:Conversiones.Severidad(Vista.TipoMensaje), Mode=OneWay}" />

                    <!-- Registro de cuentas nuevas (solo alumnos y docentes con correo @uanl.edu.mx) -->
                    <Border Height="1" Background="{StaticResource Linea}" Margin="0,6,0,0" />
                    <TextBlock Text="¿Eres alumno o docente y no tienes cuenta?" Style="{StaticResource Etiqueta}" Margin="0,6,0,0" />
                    <Button x:Name="botonCrearCuenta" Content="Crear cuenta" Style="{StaticResource BotonOro}" Command="{x:Bind Vista.CrearCuentaCommand}" />
                    <TextBlock Text="¿Olvidaste tu contraseña? El administrador puede restablecerla." Style="{StaticResource Etiqueta}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
