<UserControl x:Class="PIA_ParkUANL.TablaDatos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid BorderBrush="{StaticResource Linea}" BorderThickness="1" Background="{StaticResource Blanco}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="encabezadoTabla" Background="{StaticResource AzulUanl}" Padding="8,7" ColumnSpacing="8" />
        <ListView x:Name="lista" Grid.Row="1" SelectionMode="Single">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#F2A900" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#F2A900" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#F2A900" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#003057" />
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#003057" />
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#003057" />
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#003057" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
