<UserControl x:Class="PIA_ParkUANL.PestanaAccesos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PIA_ParkUANL">
    <Grid Background="{StaticResource Fondo}" Padding="10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <local:TarjetaResumen Titulo="FACPYA" Datos="{x:Bind Vista.TarjetaFacpya, Mode=OneWay}" />
            <local:TarjetaResumen Grid.Column="1" Titulo="Estadio" Datos="{x:Bind Vista.TarjetaEstadio, Mode=OneWay}" />
            <local:TarjetaResumen Grid.Column="2" Titulo="Alumnos adentro" Datos="{x:Bind Vista.TarjetaAlumnos, Mode=OneWay}" />
            <local:TarjetaResumen Grid.Column="3" Titulo="Docentes adentro" Datos="{x:Bind Vista.TarjetaDocentes, Mode=OneWay}" />
            <local:TarjetaResumen Grid.Column="4" Titulo="Visitantes adentro" Datos="{x:Bind Vista.TarjetaVisitantes, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Categoría" Style="{StaticResource EtiquetaCentrada}" />
            <ComboBox x:Name="comboFiltroCategoria" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vista.OpcionesDeCategoria}"
                      SelectedItem="{x:Bind Vista.FiltroCategoria, Mode=TwoWay, Converter={StaticResource ATexto}}" />
            <TextBlock Grid.Column="2" Text="Estacionamiento" Style="{StaticResource EtiquetaCentrada}" />
            <ComboBox x:Name="comboFiltroEstacionamiento" Grid.Column="3" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vista.OpcionesDeEstacionamiento}"
                      SelectedItem="{x:Bind Vista.FiltroEstacionamiento, Mode=TwoWay, Converter={StaticResource ATexto}}" />
            <TextBlock Grid.Column="4" Text="Estado" Style="{StaticResource EtiquetaCentrada}" />
            <ComboBox x:Name="comboFiltroEstado" Grid.Column="5" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vista.OpcionesDeEstado}"
                      SelectedItem="{x:Bind Vista.FiltroEstado, Mode=TwoWay, Converter={StaticResource ATexto}}" />
            <TextBlock Grid.Column="6" Text="Buscar" Style="{StaticResource EtiquetaCentrada}" />
            <TextBox x:Name="cajaFiltroBuscar" Grid.Column="7" Text="{x:Bind Vista.Busqueda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="botonLimpiarFiltros" Grid.Column="8" Content="Limpiar filtros" Style="{StaticResource BotonGris}" VerticalAlignment="Stretch" Command="{x:Bind Vista.LimpiarFiltrosCommand}" />
            <TextBlock x:Name="etiquetaConteo" Grid.Column="9" Style="{StaticResource EtiquetaCentrada}" Text="{x:Bind Vista.Conteo, Mode=OneWay}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Corregir el registro seleccionado:" Style="{StaticResource EtiquetaCentrada}" />
            <Button x:Name="botonAnular" Content="Anular registro" Width="150" Style="{StaticResource BotonRojo}" Command="{x:Bind Vista.AnularCommand}" />
            <Button x:Name="botonDeshacer" Content="Deshacer salida" Width="150" Style="{StaticResource BotonAzul}" Command="{x:Bind Vista.DeshacerSalidaCommand}" />
        </StackPanel>

        <local:TablaDatos x:Name="tablaAccesos" Grid.Row="3" Columnas="Placa,Nombre,Categoría,Matrícula,Lugar,Cajón,Evento,Método,Entrada,Salida,Estancia,Estado"
                          Filas="{x:Bind Vista.Filas, Mode=OneWay}" DatoSeleccionado="{x:Bind Vista.RegistroElegido, Mode=TwoWay}" />

        <TextBlock Grid.Row="4" Style="{StaticResource Etiqueta}" Foreground="{StaticResource AzulUanl}"
                   Text="Fórmulas → Capacidad efectiva = Total − Reservados · Disponibles = Efectiva − Adentro · % Ocupación = Adentro ÷ Efectiva × 100 · Promedio = Σ(salida − entrada) ÷ estancias" />
    </Grid>
</UserControl>
