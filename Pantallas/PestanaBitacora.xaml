<UserControl x:Class="PIA_ParkUANL.PestanaBitacora"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PIA_ParkUANL">
    <Grid Background="{StaticResource Fondo}" Padding="10">
        <local:TablaDatos x:Name="tablaBitacora" Columnas="Fecha,Usuario,Acción,Detalle,Motivo" Filas="{x:Bind Vista.Filas, Mode=OneWay}" />
    </Grid>
</UserControl>
