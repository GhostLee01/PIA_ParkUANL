<Page x:Class="PIA_ParkUANL_Lite.PaseQrPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PIA_ParkUANL_Lite"
      Background="{StaticResource Fondo}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:EncabezadoUanl Titulo="Mi pase QR" Subtitulo="{x:Bind Vista.Subtitulo}" ComandoCuenta="{x:Bind Vista.CambiarContrasenaCommand}" />
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="24,14,24,14" ColumnSpacing="20" MinWidth="720">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna izquierda: el código QR -->
                <StackPanel Spacing="6">
                    <Border Background="{StaticResource Blanco}">
                        <Image x:Name="imagenQr" Width="300" Height="300" Stretch="Uniform"
                               Source="{x:Bind local:Conversiones.ImagenDeQr(Vista.Imagen), Mode=OneWay}" />
                    </Border>
                    <TextBlock x:Name="etiquetaCuentaRegresiva" Style="{StaticResource Mensaje}" HorizontalAlignment="Center"
                               Text="{x:Bind Vista.TextoCuentaRegresiva, Mode=OneWay}"
                               Foreground="{x:Bind local:Conversiones.ColorDeAlerta(Vista.EstaPorVencer), Mode=OneWay}" />
                    <ProgressBar x:Name="barraTiempo" Height="8" Maximum="{x:Bind Vista.SegundosDeVigencia}" Value="{x:Bind Vista.SegundosRestantes, Mode=OneWay}" />
                </StackPanel>

                <!-- Columna derecha: datos, disponibilidad y botones -->
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock x:Name="etiquetaDatos" Style="{StaticResource Mensaje}" Foreground="{StaticResource AzulUanl}" Text="{x:Bind Vista.DatosDeLaPersona}" />
                    <TextBlock Text="Vehículo con el que voy a entrar" Style="{StaticResource Etiqueta}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="comboVehiculo" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vista.Vehiculos, Mode=OneWay}"
                                  SelectedItem="{x:Bind Vista.VehiculoElegido, Mode=TwoWay, Converter={StaticResource ATexto}}" />
                        <Button x:Name="botonVehiculos" Grid.Column="1" Content="Mis vehículos" Style="{StaticResource BotonOro}" Command="{x:Bind Vista.AbrirMisVehiculosCommand}" />
                    </Grid>

                    <Border Style="{StaticResource Grupo}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Lugares disponibles ahora" Style="{StaticResource TituloGrupo}" />
                            <TextBlock x:Name="etiquetaFacpya" Style="{StaticResource Etiqueta}" Text="{x:Bind Vista.TextoFacpya, Mode=OneWay}"
                                       Foreground="{x:Bind local:Conversiones.ColorDeSemaforo(Vista.SemaforoFacpya), Mode=OneWay}" />
                            <TextBlock x:Name="etiquetaEstadio" Style="{StaticResource Etiqueta}" Text="{x:Bind Vista.TextoEstadio, Mode=OneWay}"
                                       Foreground="{x:Bind local:Conversiones.ColorDeSemaforo(Vista.SemaforoEstadio), Mode=OneWay}" />
                            <TextBlock x:Name="etiquetaRecomendacion" Style="{StaticResource Etiqueta}" Foreground="{StaticResource AzulUanl}"
                                       Text="{x:Bind Vista.Recomendacion, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Texto del QR (para pegarlo en la caseta durante la demo):" Style="{StaticResource Etiqueta}" />
                    <TextBox x:Name="cajaToken" IsReadOnly="True" Text="{x:Bind Vista.Token, Mode=OneWay}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="botonCopiar" Content="Copiar texto" Style="{StaticResource BotonOro}" Command="{x:Bind Vista.CopiarTokenCommand}" />
                        <Button x:Name="botonNuevo" Grid.Column="1" Content="Nuevo QR" Style="{StaticResource BotonAzul}" Command="{x:Bind Vista.NuevoQrCommand}" />
                    </Grid>
                    <Button x:Name="botonSalir" Content="Cerrar sesión" Style="{StaticResource BotonRojo}" Command="{x:Bind Vista.CerrarSesionCommand}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
